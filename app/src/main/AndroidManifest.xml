<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ 需要动态申请通知权限，用户拒绝后 App 内用横幅降级展示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FridgeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fridge">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.inventory.IngredientDetailActivity"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.inventory.IngredientEditActivity"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.recipes.RecipeDetailActivity"
            android:parentActivityName=".ui.MainActivity" />
    </application>

</manifest>
